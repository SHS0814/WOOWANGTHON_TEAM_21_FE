# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.
# mock (기본): 모의 서버. http: 실제 서버
EXPO_PUBLIC_API_MODE=mock
# http 일 때 필수. /api/v1 까지 포함
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# true 이면 G1 에서 시연용 가족(is_demo)으로 만든다. 서버가 DEMO_MODE=true 여야 한다
EXPO_PUBLIC_CREATE_DEMO_FAMILY=false
# Android 보호자 푸시용 Firebase 설정 파일 경로 (저장소 밖). 비우면 푸시 없이 빌드된다 (README "보호자 푸시")
# 예: GOOGLE_SERVICES_JSON=~/woowang-secrets/google-services.json
GOOGLE_SERVICES_JSON=
